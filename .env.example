# Copy to .env and fill in what you need. .env is git-ignored and must never be committed.
# This file lists names only. Leave a value empty to use the default behaviour.
# Meanings: docs/ARCHITECTURE.md section 12.

# Folder for the vault and logs (put it outside the repository)
VERIDOC_HOME=
# Local port (default chosen at start)
VERIDOC_PORT=
# Force a hardware tier (high, default, low, safe)
VERIDOC_TIER=
# Force rules-only mode (1 to turn on)
VERIDOC_SAFE_MODE=
# Model adapter: fake (recorded outputs) or local (real model, not built yet)
VERIDOC_MODEL_MODE=
# Folder holding model files (never commit model weights)
VERIDOC_MODEL_DIR=
# Path to models/manifest.json
VERIDOC_MANIFEST_PATH=
# Import size cap in megabytes
VERIDOC_MAX_IMPORT_MB=
# Log level
VERIDOC_LOG_LEVEL=
# Comma-separated names of unfinished features to switch on
VERIDOC_FEATURE_FLAGS=
# Switch stubs and fixtures on for the demo (1 to turn on)
VERIDOC_DEMO_MODE=
# Hardware tier thresholds in GB of RAM (tuned by benchmark)
VERIDOC_TIER_HIGH_MIN_RAM_GB=
VERIDOC_TIER_DEFAULT_MIN_RAM_GB=
VERIDOC_TIER_LOW_MIN_RAM_GB=

# P1 only, off by default
# Enable anchoring (1 to turn on)
VERIDOC_ANCHOR_ENABLED=
# Anchoring network endpoint
VERIDOC_ANCHOR_RPC=
# Share server base URL
VERIDOC_SHARE_BASE_URL=
